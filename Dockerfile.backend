FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Seed DB on startup and run FastAPI server
EXPOSE 8000
CMD ["sh", "-c", "PYTHONPATH=. python app/data/seed.py && uvicorn app.api.main:app --host 0.0.0.0 --port 8000"]
